# Copy to .env and adjust.
DB_NAME=memsto
DB_USER=memsto
DB_PASSWORD=memsto
DB_ROOT_PASSWORD=root

# Local (SeaweedFS): defaults below work as-is; keys must match infra/seaweedfs/s3.json.
# Production (Cloudflare R2):
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=memsto
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey

# Session token signing key (>= 32 bytes). Generate for prod: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
